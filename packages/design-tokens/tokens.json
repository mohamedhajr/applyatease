    "warning": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.607843, 0.439216, 0.176471],
        "alpha": 1
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "control": {
      "$value": {
        "value": 6,
        "unit": "px"
      }
    },
    "panel": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    }
