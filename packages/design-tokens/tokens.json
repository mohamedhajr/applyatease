{
  "color": {
    "$type": "color",
    "canvas": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.964706, 0.968627, 0.980392],
        "alpha": 1
      }
    },
    "panel": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1.0, 1.0, 1.0],
        "alpha": 1
      }
    },
    "text": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.207843, 0.25098, 0.352941],
        "alpha": 1
      }
    },
    "muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.392157, 0.443137, 0.541176],
        "alpha": 1
      }
    },
    "border": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.905882, 0.917647, 0.945098],
        "alpha": 1
      }
    },
    "accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.298039, 0.368627, 0.835294],
        "alpha": 1
      }
    },
    "accent-soft": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.929412, 0.941176, 0.988235],
        "alpha": 1
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
