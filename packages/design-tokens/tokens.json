{
  "color": {
    "$type": "color",
    "canvas": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.98, 0.976, 0.969],
        "alpha": 1
      }
    },
    "panel": {
      "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 1 }
    },
    "text": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.157, 0.176, 0.169],
        "alpha": 1
      }
    },
    "muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.388, 0.412, 0.396],
        "alpha": 1
      }
    },
    "border": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.878, 0.886, 0.867],
        "alpha": 1
      }
    },
    "accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.184, 0.329, 0.278],
        "alpha": 1
      }
    },
    "accent-soft": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.918, 0.945, 0.918],
        "alpha": 1
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "control": { "$value": { "value": 6, "unit": "px" } },
    "panel": { "$value": { "value": 12, "unit": "px" } }
  }
}
