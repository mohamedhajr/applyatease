{
  "name": "applyatease",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.12.1 <27"
  },
  "scripts": {
    "dev:web": "pnpm --filter @applyatease/design-tokens build && pnpm --filter @applyatease/web dev",
    "dev:desktop": "pnpm setup:desktop && pnpm --filter @applyatease/design-tokens build && pnpm --filter @applyatease/desktop dev",
    "dev:api": "pnpm --filter @applyatease/api dev",
    "build": "pnpm --filter @applyatease/design-tokens build && pnpm --filter @applyatease/api build && pnpm --filter @applyatease/web build && pnpm --filter @applyatease/desktop build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware && effect-tsgo diagnostics --project tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "ci:check": "tsx .dagger/check.ts",
    "db:migrate": "pnpm --filter @applyatease/api db:migrate",
    "package:desktop": "pnpm --filter @applyatease/design-tokens build && pnpm --filter @applyatease/desktop package",
    "test:web": "playwright test",
    "test:desktop": "pnpm setup:desktop && tsx apps/desktop/test/smoke.ts",
    "setup:desktop": "pnpm --filter @applyatease/desktop run setup",
    "test:desktop:packaged": "tsx apps/desktop/test/smoke.ts --packaged"
  },
  "devDependencies": {
    "@dagger.io/dagger": "0.21.11",
    "@effect/language-service": "0.87.5",
    "@effect/tsgo": "0.63.0",
    "@effect/vitest": "4.0.7",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
